<div {{ attributes }} class="w-full bg-white dark:bg-gray-800 rounded-3xl border border-gray-200 dark:border-gray-700 p-6 md:p-8 shadow-sm">
    {% set user = this.user %}
    {% set refUrl = this.referralUrl %}
    {% set shares = this.socialShares %}

    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 pb-6 border-b border-gray-100 dark:border-gray-700">
        <div>
            <span class="inline-flex items-center gap-1.5 px-3 py-1 text-xs font-bold text-primary-700 bg-primary-50 dark:bg-primary-900/40 dark:text-primary-300 rounded-full mb-2">
                <span>🔥 {{ 'Viral Growth Loop' | trans }}</span>
            </span>
            <h2 class="text-2xl font-black text-gray-900 dark:text-white">{{ 'Share Your Private Invite Link' | trans }}</h2>
            <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">
                {{ 'Earn 50 points for every friend who joins. They receive a 20 points welcome bonus.' | trans }}
            </p>
        </div>

        {# Mini Stats Pill #}
        <div class="flex items-center gap-3 bg-gray-50 dark:bg-gray-900 p-2.5 rounded-2xl border border-gray-200 dark:border-gray-800">
            <div class="px-3 text-center">
                <span class="block text-xl font-black text-gray-900 dark:text-white">{{ user ? user.referralsCount : 0 }}</span>
                <span class="text-[10px] uppercase font-bold text-gray-400">{{ 'Friends' | trans }}</span>
            </div>
            <div class="h-8 w-px bg-gray-200 dark:bg-gray-700"></div>
            <div class="px-3 text-center">
                <span class="block text-xl font-black text-primary-600 dark:text-primary-400">{{ user ? user.points : 0 }}</span>
                <span class="text-[10px] uppercase font-bold text-gray-400">{{ 'Points' | trans }}</span>
            </div>
            <div class="h-8 w-px bg-gray-200 dark:bg-gray-700"></div>
            <div class="px-3 text-center">
                <span class="block text-xl font-black text-emerald-600 dark:text-emerald-400">{{ user ? user.referralClicks : 0 }}</span>
                <span class="text-[10px] uppercase font-bold text-gray-400">{{ 'Clicks' | trans }}</span>
            </div>
        </div>
    </div>

    {# Referral URL Bar with 1-click Copy #}
    <div class="mt-6" data-controller="copy">
        <label class="block text-xs font-bold uppercase tracking-wider text-gray-500 dark:text-gray-400 mb-2">
            {{ 'Your Unique Invite URL' | trans }}
        </label>
        <div class="flex flex-col sm:flex-row items-stretch gap-3">
            <div class="relative flex-1">
                <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-gray-400">
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
                    </svg>
                </div>
                <input 
                    type="text" 
                    readonly 
                    value="{{ refUrl }}" 
                    data-copy-target="source"
                    class="w-full pl-11 pr-4 py-3 bg-gray-50 dark:bg-gray-900 border border-gray-200 dark:border-gray-700 rounded-2xl text-sm font-mono text-gray-800 dark:text-gray-200 focus:ring-2 focus:ring-primary-500 select-all"
                >
            </div>
            <button 
                type="button" 
                data-action="click->copy#copy"
                class="px-6 py-3 bg-primary-600 hover:bg-primary-700 text-white font-bold text-sm rounded-2xl shadow-md hover:shadow-lg transition-all flex items-center justify-center gap-2"
            >
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                </svg>
                <span data-copy-target="buttonText">{{ 'Copy Link' | trans }}</span>
            </button>
        </div>
    </div>

    {# 1-Click Social Sharing Buttons #}
    <div class="mt-8 pt-6 border-t border-gray-100 dark:border-gray-700">
        <label class="block text-xs font-bold uppercase tracking-wider text-gray-500 dark:text-gray-400 mb-3">
            {{ 'Share via 1-Click to Viral Channels' | trans }}
        </label>
        <div class="grid grid-cols-2 sm:grid-cols-5 gap-3">
            {% for platform, share in shares %}
                <a 
                    href="{{ share.url }}" 
                    target="_blank" 
                    rel="noopener noreferrer"
                    class="p-3 text-center rounded-2xl {{ share.colorClass }} text-xs font-bold shadow-sm hover:shadow transition-all duration-200 flex items-center justify-center gap-2"
                >
                    <span>{{ share.name }}</span>
                    <svg class="w-3.5 h-3.5 opacity-80" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                    </svg>
                </a>
            {% endfor %}
        </div>
    </div>
</div>
